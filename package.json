{
  "name": "movingmanifest",
  "version": "0.2.0",
  "private": true,
  "bin": {
    "movingmanifest-mcp": "./mcp-server/movingmanifest-mcp.mjs"
  },
  "scripts": {
    "dev": "next dev -p 3827",
    "build": "next build",
    "start": "next start -p 3827",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "contract:drift": "node scripts/contract-drift-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:launch": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "doctor:launch": "node scripts/launch-readiness.mjs",
    "doctor:vercel-env": "node scripts/vercel-env-readiness.mjs",
    "doctor:vercel-preview-env": "node scripts/vercel-env-readiness.mjs --environment preview",
    "doctor:release": "node scripts/release-readiness.mjs",
    "doctor:convex-env": "node scripts/convex-env-readiness.mjs",
    "doctor:convex-dev-env": "node --env-file=.env.local scripts/convex-env-readiness.mjs --deployment-from-env --compare-local-storage",
    "doctor:storage": "node --no-warnings --env-file=.env.local scripts/storage-readiness.mjs",
    "doctor:layout-studio-qa": "node --env-file=.env.local scripts/layout-studio-qa-readiness.mjs",
    "doctor:webhooks": "node --env-file=.env.local scripts/webhook-readiness.mjs",
    "doctor:mcp-discovery": "node scripts/mcp-readonly-discovery-proof.mjs",
    "doctor:all": "npm run doctor:launch && npm run doctor:vercel-env && npm run doctor:vercel-preview-env && npm run doctor:release && npm run doctor:convex-env && npm run doctor:convex-dev-env && npm run doctor:storage && npm run doctor:webhooks",
    "doctor:next": "node scripts/launch-next-steps.mjs",
    "mcp:doctor": "node scripts/mcp-oauth-discovery-proof.mjs --endpoint https://movingmanifest.com/api/mcp",
    "smoke:agent-journey": "node scripts/agent-journey-smoke.mjs",
    "smoke:mcp-stdio": "node scripts/mcp-stdio-smoke.mjs",
    "mcp": "node ./mcp-server/movingmanifest-mcp.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@clerk/nextjs": "^7.4.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.40.0",
    "lucide-react": "^1.17.0",
    "mcp-handler": "^1.1.0",
    "next": "16.2.7",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.10.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@clerk/testing": "^2.0.35",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "8.5.15",
    "mcp-handler": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
    }
  }
}

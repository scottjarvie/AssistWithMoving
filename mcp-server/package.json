{
  "name": "assistwithmoving-mcp",
  "version": "0.2.0",
  "description": "MCP server for Assist With Moving — lets AI agents manage moves, inventory, boxes, and photos through the Assist With Moving API.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "assistwithmoving-mcp": "./assistwithmoving-mcp.mjs"
  },
  "main": "./assistwithmoving-mcp.mjs",
  "exports": {
    ".": "./assistwithmoving-mcp.mjs",
    "./api": "./assistwithmoving-api.mjs",
    "./capabilities": "./capabilities.mjs"
  },
  "files": [
    "assistwithmoving-mcp.mjs",
    "assistwithmoving-api.mjs",
    "capabilities.mjs",
    "example-desktop-config.json"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moving",
    "inventory",
    "assistwithmoving"
  ],
  "homepage": "https://movingmanifest.com/mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}

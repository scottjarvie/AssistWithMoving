# AI providers
AI_DEFAULT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_INPUT_CENTS_PER_MILLION=25
OPENAI_OUTPUT_CENTS_PER_MILLION=200
ANTHROPIC_API_KEY=

# App security
API_KEY_PEPPER=
ADMIN_EMAILS=

# Maintainer-only local MCP server
MOVINGMANIFEST_API_KEY=
# Optional path-delimited trusted directories. Local filePath tools are disabled
# when this is empty; hosted MCP always rejects filePath.
MOVINGMANIFEST_MCP_ALLOWED_FILE_ROOTS=

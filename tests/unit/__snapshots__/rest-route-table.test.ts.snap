  "POST /moves/{moveId}/items | inventory/write | 201 | data | object",
  "POST /moves/{moveId}/items/batch-upsert | inventory/write | 400 | error | {"code":"invalid_batch","message":"items must include at least one row."}",
  "GET /moves/{moveId}/movable-units | inventory/read | 404 | error | {"code":"not_found","message":"Movable units route not found."}",
  "POST /moves/{moveId}/movable-units/batch-upsert | inventory/write | 400 | error | {"code":"invalid_batch","message":"units must include at least one row."}",

exports[`authenticates before dispatch and keeps scope, move access and cursor semantics > authentication and access refusals 1`] = `
{
  "invalidKey": {
    "body": {
      "error": {
        "code": "request_failed",
        "message": "Invalid API key format. The key is the wrong shape — copy the full key from Settings → AI Connections, or rotate it.",
      },
    },
    "status": 401,
  },
  "knownAnonymous": {
    "body": {
      "error": {
        "code": "unauthorized",

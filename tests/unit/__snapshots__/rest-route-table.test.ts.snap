exports[`pins the route families, scopes, responses and refusal shapes with a fixture key 1`] = `
[
  "GET /me | moves/read | 200 | data | object",
  "POST /me/access | no scopes | 400 | error | {"code":"request_failed","message":"Your AI can only reduce its own connection. To increase or restore access, the person must open https://movingmanifest.com/settings/ai."}",
  "GET /households/{householdId}/members | members/manage | 200 | data | array (1)",
  "POST /households/{householdId}/members | members/manage | 403 | error | {"code":"request_failed","message":"Household invitations are website-only. The person must use https://movingmanifest.com/settings/ai."}",
  "GET /moves | moves/read | 200 | data, page | array (1)",
  "POST /moves | moves/write | 400 | error | {"code":"invalid_move","message":"title is required."}",
  "POST /moves/setup | moves/read, moves/write, inventory/write | 400 | error | {"code":"invalid_move_setup","message":"title is required when setup is creating a move."}",
  "GET /moves/{moveId} | moves/read | 200 | data | object",
  "GET /moves/{moveId}/summary | moves/read, inventory/read, exports/read | 200 | data | object",
  "GET /moves/{moveId}/questions | moves/read, inventory/read | 200 | data | object",
  "GET /moves/{moveId}/move-day | moves/read, inventory/read | 200 | data | object",
  "GET /moves/{moveId}/capacity-report | moves/read, inventory/read | 200 | data | object",
  "GET /moves/{moveId}/agent-context | moves/read, inventory/read, plans/read | 200 | data | object",
  "GET /moves/{moveId}/spaces | moves/read | 200 | data, page | array (0)",
  "POST /moves/{moveId}/spaces | moves/write | 400 | error | {"code":"request_failed","message":"name is required."}",

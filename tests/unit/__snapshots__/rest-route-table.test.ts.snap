    "body": {
      "error": {
        "code": "request_failed",
        "message": "API key is missing required scope: inventory/read. Only the person can restore it at https://movingmanifest.com/settings/ai.",
      },
    },
    "status": 403,
  },
  "outsideMove": {
    "body": {
      "error": {
        "code": "request_failed",
        "message": "Missing power: access to that move. Only the person can restore it at https://movingmanifest.com/settings/ai.",
